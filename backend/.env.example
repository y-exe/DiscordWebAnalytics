DB_DSN=postgresql://user:password@postgres-db:5432/database
API_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_SECRET=replace-with-another-32-character-random-secret
ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$base64url-salt$base64url-hash
TRUST_CLOUDFLARE_PROXY=false
CLOUDFLARE_TRUSTED_PROXY_CIDRS=
CACHE_SIZE_LIMIT_BYTES=268435456

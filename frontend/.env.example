ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$base64url-salt$base64url-hash

ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloudflare Workers / 独立デプロイ用 (既定のフォールバック api.ymkw.top)
NEXT_PUBLIC_API_URL=https://api.ymkw.top
NEXT_PUBLIC_ADMIN_API_URL=https://api.ymkw.top

# 同一オリジン運用 (k3s統合コンテナ、フロントとAPIを同じホストで提供する場合)
# APIはHonoがNextにマウントされ同一プロセスで処理されるため、中継プロキシは不要。
# SSRはループバックの /api プレフィックス付きベースURLでセルフ呼び出しする。
# DB_DSN / API_SECRET / ADMIN_SESSION_SECRET も同じプロセスで必要 (backend/.env.example 参照)
# NEXT_PUBLIC_SAME_ORIGIN=true
# API_URL=http://127.0.0.1:4321/api
# DB_DSN=postgresql://...
# API_SECRET=replace-with-at-least-32-random-characters

GA_ID=G-XXXXXXXXXX

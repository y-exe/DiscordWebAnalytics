# PBKDF2-HMAC-SHA-256形式の値を入れる
# `cd scripts && npm run generate:admin-password-hash` で生成すること。
ADMIN_PASSWORD_HASH=pbkdf2-sha256$600000$base64url-salt$base64url-hash

# backendのADMIN_SESSION_SECRET
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# BackendAPI（Backendは自分で構築してね）
NEXT_PUBLIC_API_URL=https://api.ymkw.top
NEXT_PUBLIC_ADMIN_API_URL=https://api.ymkw.top

# GAS 測定ID
GA_ID=G-XXXXXXXXXX

---
import Layout from "../../../layouts/Layout.astro";
import AdminMonthGate from "../../../components/AdminMonthGate.jsx";

export function getStaticPaths() {
  const paths = [];
  for (let year = 2020; year <= 2100; year += 1) {
    for (let month = 1; month <= 12; month += 1) paths.push({ params: { year: String(year), month: String(month) } });
  }
  return paths;
}

const { year, month } = Astro.params;
const targetYear = Number(year);
const targetMonth = Number(month);
const pageTitle = `${targetYear}年${targetMonth}月レポート`;
const pageDescription = `${targetYear}年${targetMonth}月のやまかわてるき鯖の活動データです。`;
const breadcrumbs = [
  { name: "トップ", item: "https://ymkw.top/" },
  { name: "月別レポート", item: `https://ymkw.top/month/${year}/${month}` },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <AdminMonthGate client:load year={year} month={month} />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import AllTimeDashboard from "../components/AllTimeDashboard.jsx";

const pageTitle = "総合ランキング";
const pageDescription = "やまかわてるき鯖の総合ランキングと活動データです。";

const breadcrumbs = [
  { name: "トップ", item: "https://ymkw.top/" },
  { name: "総合ランキング", item: "https://ymkw.top/all" },
];
---

<Layout title={pageTitle} description={pageDescription} breadcrumbs={breadcrumbs}>
  <AllTimeDashboard client:load channelId={null} userId={null} />
</Layout>

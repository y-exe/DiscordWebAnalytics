---
interface Props { label: string; }
const { label } = Astro.props;
---

<span class="social-reel" aria-hidden="true">
  {Array.from(label).map((character, index) => (
    <span class="social-reel-character">
      <span class="social-reel-track" style={`--reel-index: ${index}`}>
        <span>{character}</span><span>{character}</span>
      </span>
    </span>
  ))}
</span>

<style>
  .social-reel { display: inline-flex; height: 1.2em; overflow: hidden; }
  .social-reel-character { display: block; height: 1.2em; overflow: hidden; }
  .social-reel-track {
    display: flex;
    flex-direction: column;
    transition: transform 420ms cubic-bezier(.16, 1, .3, 1);
    transition-delay: calc(var(--reel-index) * 38ms);
  }
  .social-reel-track > span { flex: none; height: 1.2em; line-height: 1.2; white-space: pre; }
  :global(.social-link:is(:hover, :focus-visible) .social-reel-track) { transform: translateY(-1.2em); }
  @media (prefers-reduced-motion: reduce) {
    .social-reel-track { transition: none; }
    :global(.social-link:is(:hover, :focus-visible) .social-reel-track) { transform: none; }
  }
</style>

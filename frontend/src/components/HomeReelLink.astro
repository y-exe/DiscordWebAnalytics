---
interface Props {
  href: string;
  label: string;
  event?: boolean;
}
const { href, label, event = false } = Astro.props;
---

<a class:list={["home-action", { "home-action--event": event }]} href={href} aria-label={label}>
  <span class="reel" aria-hidden="true">
    {Array.from(label).map((character, index) => (
      <span class="reel-character">
        <span class="reel-track" style={`--reel-index: ${index}`}>
          <span>{character}</span><span>{character}</span>
        </span>
      </span>
    ))}
  </span>
  <span class="reel arrow" aria-hidden="true">
    <span class="reel-character">
      <span class="reel-track" style="--reel-index: 12"><span>→</span><span>→</span></span>
    </span>
  </span>
</a>

<style>
  /* Typography and staggered text roll follow Vote's home hero links. */
  .home-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .65em;
    min-height: 66px;
    padding: .42em .72em .5em;
    overflow: hidden;
    color: #fff;
    background: rgb(0 0 0 / 78%);
    font-size: clamp(19px, 2vw, 30px);
    font-weight: 800;
    line-height: 1.2;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 200ms;
  }
  .home-action--event {
    background: linear-gradient(112deg, #5b2cb7 0%, #8e43c9 48%, #d24aac 100%);
    padding-inline: 1em;
  }
  .home-action:hover { background-color: #252525; }
  .home-action:focus-visible { outline: 3px solid #ffe33c; outline-offset: 5px; }
  .reel { display: inline-flex; height: 1.2em; overflow: hidden; }
  .reel-character { display: block; height: 1.2em; overflow: hidden; }
  .reel-track {
    display: flex;
    flex-direction: column;
    transition: transform 420ms cubic-bezier(.16, 1, .3, 1);
    transition-delay: calc(var(--reel-index) * 38ms);
  }
  .reel-track > span { flex: none; height: 1.2em; line-height: 1.2; white-space: pre; }
  .home-action:is(:hover, :focus-visible) .reel-track { transform: translateY(-1.2em); }
  .arrow { font-family: "LINE Seed JP", Arial, sans-serif; font-weight: 800; }
  @media (prefers-reduced-motion: reduce) {
    .reel-track { transition: none; }
    .home-action:is(:hover, :focus-visible) .reel-track { transform: none; }
  }
</style>
